# Backend Environment Variables for Railway

NODE_ENV=production
PORT=8000

# JWT Secret (IMPORTANT: Generate a strong secret)
JWT_SECRET=your-super-secret-jwt-key-make-it-very-long-and-random-production-key-123456789

# CORS Configuration
FRONTEND_URL=https://your-app-name.vercel.app

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Database Configuration (Railway auto-provides these)
# MYSQL_HOST=auto-provided-by-railway
# MYSQL_PORT=auto-provided-by-railway  
# MYSQL_USER=auto-provided-by-railway
# MYSQL_PASSWORD=auto-provided-by-railway
# MYSQL_DATABASE=auto-provided-by-railway
