# Vercel Environment Variables Template
# Add these in your Vercel project settings under "Environment Variables"

# Database Configuration
DB_HOST=your_database_host
DB_PORT=3306
DB_USER=your_database_username
DB_PASSWORD=your_database_password
DB_NAME=your_database_name

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_make_it_very_long_and_random_production_key_123456789

# Migration Security (optional)
MIGRATION_SECRET=your_migration_secret_key

# Example values for Railway MySQL (if keeping Railway database):
# DB_HOST=containers-us-west-XXX.railway.app
# DB_PORT=6543
# DB_USER=root
# DB_PASSWORD=your_railway_password
# DB_NAME=railway
